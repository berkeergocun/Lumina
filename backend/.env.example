# Uygulama
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3000

# MongoDB - Docker
MONGODB_URI=mongodb://admin:smartanalytics123@localhost:27017/smartanalytics?authSource=admin

# Redis - Docker
REDIS_URL=redis://:smartanalytics123@localhost:6379

# JWT
JWT_ACCESS_SECRET=super-secret-access-key-change-in-production-32chars
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production-32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# E-posta (SMTP)
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@smartanalytics.io

# GeoIP (MaxMind GeoLite2 - ücretsiz lisans gerektirir)
# https://dev.maxmind.com/geoip/geolite2-free-geolocation-data/
MAXMIND_DB_PATH=./data/GeoLite2-City.mmdb
GEOIP_ENABLED=false

# Önbellek
REPORT_CACHE_TTL=300
REALTIME_UPDATE_INTERVAL=5000

# CDN (üretimde değiştirin)
TRACKER_CDN_URL=http://localhost:3001

# CORS (virgülle ayırınız)
CORS_ORIGINS=http://localhost:3000
