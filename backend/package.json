{
  "name": "lumina-backend",
  "version": "1.0.0",
  "description": "Lumina Analytics Backend — Gizlilik odaklı, self-hosted web analitik platformu. GDPR uyumlu, gerçek zamanlı ziyaretçi takibi, oturum analizi ve kapsamlı raporlama API'si.",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/ua-parser-js": "^0.7.39"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.3",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/swagger": "^1.3.1",
    "bcryptjs": "^3.0.3",
    "elysia": "^1.4.26",
    "ioredis": "^5.10.0",
    "mongoose": "^9.2.3",
    "nanoid": "^5.1.6",
    "ua-parser-js": "^2.0.9",
    "zod": "^4.3.6"
  }
}
